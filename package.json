{
  "name": "stormforge",
  "version": "1.0.0",
  "description": "Scope-guarded, non-destructive bug-bounty recon and vulnerability detection framework for Cloudflare Workers + Durable Objects.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
